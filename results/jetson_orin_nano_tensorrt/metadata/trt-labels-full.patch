+_TRT_PLACEHOLDER_RE = re.compile(r"class\d+")
+
+
+def _canonical_trt_class_name(names, cls_id: int, backend: str) -> str:
+    """Map TensorRT engine class ids onto the canonical COCO labels.
+
+    TensorRT engines built from the YOLOv8 ONNX exports carry placeholder
+    names (class0...classN) instead of COCO names, so ultralytics returns
+    class2/class5. Engine outputs are COCO-class-ordered; verified on this
+    Jetson against the ONNX path on the same frame (identical boxes with
+    canonical labels in results/full-20260908-v1 preflights). The canonical
+    label list is the single source of truth shared with the ONNX parser:
+    COCO_NAMES defined above in this module (same list the ONNX/PyTorch
+    paths use). Out-of-range ids degrade to str(cls_id) exactly like the
+    ONNX parser. Non-placeholder engine metadata names are kept verbatim,
+    and the remap fires only when backend == 'tensorrt' so ONNX/PyTorch
+    behaviour is byte-for-byte unchanged.
+    """
+    raw = str(names[cls_id] if isinstance(names, dict) else names[cls_id])
+    if backend == "tensorrt" and _TRT_PLACEHOLDER_RE.fullmatch(raw):
+        if 0 <= cls_id < len(COCO_NAMES):
+            return COCO_NAMES[cls_id]
+        return str(cls_id)
+    return raw
+
+
