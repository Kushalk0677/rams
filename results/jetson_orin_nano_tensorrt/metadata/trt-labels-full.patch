diff --git a/tests/test_trt_class_labels.py b/tests/test_trt_class_labels.py
new file mode 100644
index 0000000..bfa3ee5
--- /dev/null
+++ b/tests/test_trt_class_labels.py
@@ -0,0 +1,111 @@
+"""Preflight: known TensorRT engine detections must convert to canonical
+labels BEFORE any policy/scorer handling. Fails without the TRT class-label
+patch (labels arrive as class0/class2/class5 placeholders)."""
+import unittest
+
+import numpy as np
+
+from rams.models import COCO_NAMES, ModelWrapper, Tier
+from rams.policy import make_policy
+
+
+class _Arr:
+    def __init__(self, values):
+        self._values = list(values)
+
+    def tolist(self):
+        return list(self._values)
+
+
+class _Box:
+    def __init__(self, cls, conf, xyxy):
+        self.cls = cls
+        self.conf = conf
+        self.xyxy = _Arr(xyxy)
+
+
+class _Result:
+    def __init__(self, boxes, names):
+        self.boxes = boxes
+        self.names = names  # real ultralytics Results carries model metadata
+
+
+class _FakeEngine:
+    """Stands in for ultralytics YOLO(engine) — returns placeholder-named
+    detections exactly like the Jetson TRT engines (names dict class0..N)."""
+
+    def __init__(self, names, boxes):
+        self.names = names
+        self._boxes = boxes
+
+    def __call__(self, frame, verbose=False, imgsz=None):
+        return [_Result(self._boxes, self.names)]
+
+
+PLACEHOLDER_NAMES = {i: f'class{i}' for i in range(999)}
+PERSON_BOX = [100.0, 60.0, 240.0, 300.0]   # near VRU (area fraction > 0.02)
+CAR_BOX = [620.0, 179.0, 700.0, 238.0]
+
+
+def _wrapper(tier, names, boxes, backend='tensorrt'):
+    wrapper = ModelWrapper(tier)
+    wrapper._backend = backend
+    wrapper._loaded = True
+    wrapper._model = _FakeEngine(names, boxes)
+    return wrapper
+
+
+def _infer(tier, names, boxes, backend='tensorrt'):
+    frame = np.zeros((376, 1241, 3), dtype='uint8')  # KITTI-shaped frame
+    return _wrapper(tier, names, boxes, backend).infer(frame)['detections']
+
+
+class TrtClassLabelPreflight(unittest.TestCase):
+    def test_engine_class_ids_become_canonical_coco_labels(self):
+        dets = _infer(Tier.NANO, PLACEHOLDER_NAMES,
+                      [_Box(5, 0.9, CAR_BOX), _Box(2, 0.7, CAR_BOX)])
+        self.assertEqual([d['class'] for d in dets], ['bus', 'car'])
+        self.assertTrue(all(d['class'] in set(COCO_NAMES) for d in dets))
+
+    def test_known_trt_detection_convert_to_canonical_before_policy(self):
+        dets = _infer(Tier.MEDIUM, PLACEHOLDER_NAMES, [_Box(0, 0.9, PERSON_BOX)])
+        self.assertEqual(dets[0]['class'], 'person')
+        policy = make_policy('safety2')
+        policy.observe(dets)
+        # Low pressure: without a canonical VRU label the two-level policy
+        # stays NANO; only a canonical 'person' triggers the near-VRU MEDIUM
+        # lock. This assertion is what fails on unpatched code.
+        self.assertEqual(policy.select_tier(0.1, Tier.NANO), Tier.MEDIUM)
+
+    def test_vru_bicycle_id_and_conf_gate(self):
+        dets = _infer(Tier.SMALL, PLACEHOLDER_NAMES, [_Box(1, 0.9, PERSON_BOX)])
+        self.assertEqual(dets[0]['class'], 'bicycle')
+        policy = make_policy('safety')
+        policy.observe(dets)
+        self.assertEqual(policy.select_tier(0.1, Tier.NANO), Tier.SMALL)
+        low = _infer(Tier.SMALL, PLACEHOLDER_NAMES, [_Box(1, 0.05, PERSON_BOX)])
+        policy2 = make_policy('safety')
+        policy2.observe(low)
+        self.assertEqual(policy2.select_tier(0.1, Tier.NANO), Tier.NANO)
+
+    def test_pytorch_path_labels_untouched(self):
+        dets = _infer(Tier.SMALL, {0: 'person', 2: 'car'},
+                      [_Box(0, 0.9, PERSON_BOX)], backend='ultralytics')
+        self.assertEqual(dets[0]['class'], 'person')
+        # TRT-only: a placeholder reaching the pytorch path stays verbatim.
+        dets2 = _infer(Tier.SMALL, PLACEHOLDER_NAMES, [_Box(2, 0.9, CAR_BOX)],
+                       backend='ultralytics')
+        self.assertEqual(dets2[0]['class'], 'class2')
+
+    def test_out_of_range_placeholder_falls_back_to_str_id(self):
+        dets = _infer(Tier.NANO, PLACEHOLDER_NAMES, [_Box(99, 0.9, CAR_BOX)])
+        self.assertEqual(dets[0]['class'], '99')
+
+    def test_engine_metadata_names_kept_verbatim(self):
+        dets = _infer(Tier.NANO, {2: 'car', 5: 'bus'},
+                      [_Box(2, 0.9, CAR_BOX)], backend='tensorrt')
+        self.assertEqual(dets[0]['class'], 'car')
+
+
+if __name__ == '__main__':
+    unittest.main()
